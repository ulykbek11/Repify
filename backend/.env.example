# Optional. Without a key the rule-based local analyzer is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional regex for origins you cannot list (Vercel previews), matched against the whole origin.
# CORS_ORIGIN_REGEX=^https://repify(-[a-z0-9-]+)?-ulykbeks-projects(-[a-z0-9]+)?\.vercel\.app$

MAX_UPLOAD_MB=60
DEBUG=false
