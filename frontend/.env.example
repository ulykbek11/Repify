# Backend (FastAPI). On a phone, use your computer's LAN IP instead of localhost.
# Leave it empty (or delete the line) for demo mode: sample analyses run from the bundle, no backend needed,
# but uploading a video does not work.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Optional: real accounts through Supabase Auth. Leave empty for local demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
